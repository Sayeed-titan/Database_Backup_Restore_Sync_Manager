<UserControl x:Class="PgBackupManager.UI.Controls.Spinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root" Width="14" Height="14">
    <Grid>
        <Path x:Name="arc" Stretch="Uniform"
              Data="M21 12a9 9 0 1 1-6.219-8.56"
              Stroke="White" StrokeThickness="2.6"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <RotateTransform x:Name="rot" Angle="0" />
            </Path.RenderTransform>
        </Path>
    </Grid>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="rot" Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:0.7" RepeatBehavior="Forever" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>

<Window x:Class="PgBackupManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PgBackupManager.UI.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PgBackupManager"
        Icon="Assets/app.ico"
        Height="900" Width="1040"
        MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBg}"
        FontFamily="{StaticResource FontUI}"
        WindowStyle="None"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Navy}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Grid Grid.Row="0" Background="{StaticResource Navy}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="25" Height="25" CornerRadius="7" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource TealColor}" Offset="0" />
                                <GradientStop Color="{StaticResource Teal2Color}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="White" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M3 5 a9 3 0 0 0 18 0 a9 3 0 0 0 -18 0 M3 5 v14 a9 3 0 0 0 18 0 V5 M3 12 a9 3 0 0 0 18 0" />
                    </Border>
                    <TextBlock Text="PgBackupManager" Foreground="White" FontWeight="Bold" FontSize="13"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                    <Border BorderBrush="#FF2C456B" BorderThickness="1" CornerRadius="5" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionBadge" Foreground="#FF6885AA" FontWeight="Bold" FontSize="9.5" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinBtn" Click="MinBtn_Click" Style="{StaticResource TitleBarButton}" Width="44">
                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="#FFAEBFD4" StrokeThickness="1.6" Data="M5 12 L19 12" />
                    </Button>
                    <Button x:Name="MaxBtn" Click="MaxBtn_Click" Style="{StaticResource TitleBarButton}" Width="44">
                        <Border Width="13" Height="13" BorderBrush="#FFAEBFD4" BorderThickness="1.6" CornerRadius="1.5" />
                    </Button>
                    <Button x:Name="CloseBtn" Click="CloseBtn_Click" Style="{StaticResource TitleCloseButton}" Width="44">
                        <Path x:Name="CloseGlyph" Width="14" Height="14" Stretch="Uniform" Stroke="#FFAEBFD4" StrokeThickness="1.7"
                              StrokeStartLineCap="Round" Data="M6 6 L18 18 M18 6 L6 18" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- TABS + CONTENT -->
            <TabControl Grid.Row="1" Style="{StaticResource DesignTabControl}" ItemContainerStyle="{StaticResource DesignTabItem}">
                <TabItem Header="Backup" IsSelected="True">
                    <views:BackupView />
                </TabItem>
                <TabItem Header="Restore">
                    <views:RestoreView />
                </TabItem>
                <TabItem Header="MSSQL Backup">
                    <views:MsSqlBackupView />
                </TabItem>
                <TabItem Header="MSSQL Restore">
                    <views:MsSqlRestoreView />
                </TabItem>
                <TabItem Header="Copy Schema">
                    <views:CopySchemaView />
                </TabItem>
                <TabItem Header="Sync">
                    <views:SyncView />
                </TabItem>
                <TabItem Header="Import">
                    <views:ImportView />
                </TabItem>
                <TabItem Header="Profiles">
                    <views:ProfilesView />
                </TabItem>
                <TabItem Header="Settings">
                    <views:SettingsView />
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>

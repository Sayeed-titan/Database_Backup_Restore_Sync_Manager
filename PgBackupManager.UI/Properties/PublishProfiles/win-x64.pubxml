<Project>
  <!--
    Self-contained, single-file, win-x64 publish profile: the output .exe
    bundles the .NET 8 runtime itself, so the machine it's installed on needs
    NOTHING pre-installed to run the app (PostgreSQL client tools are a
    separate, deliberate exception — configured via Settings after install,
    not bundled, per the "app only" packaging choice).

    Usage: dotnet publish PgBackupManager.UI\PgBackupManager.UI.csproj -c Release -p:PublishProfile=win-x64
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <PublishDir>bin\Release\net8.0-windows\win-x64\publish\</PublishDir>
  </PropertyGroup>
</Project>

<UserControl x:Class="PgBackupManager.UI.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PgBackupManager.UI.ViewModels"
             xmlns:ctrl="clr-namespace:PgBackupManager.UI.Controls">
    <UserControl.DataContext>
        <vm:ProfilesViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="RowName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Navy}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Secondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="#FFCDEBF3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,22,24,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="Connection Profiles" Style="{StaticResource H1}" VerticalAlignment="Center" />
                    <TextBlock Text="— passwords encrypted with Windows DPAPI (per user)" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="10,3,0,0" />
                </StackPanel>

                <Border Style="{StaticResource Card}" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource CardSubtle}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                            <Grid Margin="16,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="NAME" Style="{StaticResource FieldLabel}" Margin="0" />
                                <TextBlock Grid.Column="1" Text="HOST" Style="{StaticResource FieldLabel}" Margin="0" />
                                <TextBlock Grid.Column="2" Text="PORT" Style="{StaticResource FieldLabel}" Margin="0" />
                                <TextBlock Grid.Column="3" Text="DATABASE" Style="{StaticResource FieldLabel}" Margin="0" />
                                <TextBlock Grid.Column="4" Text="USER" Style="{StaticResource FieldLabel}" Margin="0" />
                                <TextBlock Grid.Column="5" Text="DEFAULT SCHEMA" Style="{StaticResource FieldLabel}" Margin="0" />
                                <TextBlock Grid.Column="6" Text="UPDATED" Style="{StaticResource FieldLabel}" Margin="0" />
                            </Grid>
                        </Border>
                        <ListBox Grid.Row="1" Background="Transparent" BorderThickness="0"
                                 ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="16,12">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#FFF0F9FC" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource Teal}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource RowName}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Host}" Style="{StaticResource RowSub}" FontFamily="{StaticResource FontMono}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Port}" Style="{StaticResource RowSub}" FontFamily="{StaticResource FontMono}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Database}" Style="{StaticResource RowSub}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Username}" Style="{StaticResource RowSub}" />
                                        <TextBlock Grid.Column="5" Text="{Binding DefaultSchema}" Style="{StaticResource RowSub}" />
                                        <TextBlock Grid.Column="6" Text="{Binding UpdatedUtc, StringFormat='yyyy-MM-dd HH:mm'}" Style="{StaticResource RowSub}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Path Width="13" Height="13" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="2" VerticalAlignment="Center" Margin="0,0,8,0"
                          Data="M12 2 a10 10 0 1 0 0 20 a10 10 0 0 0 0 -20 M12 16 L12 12 M12 8 L12.01 8" />
                    <TextBlock Text="Select a profile to edit, delete, or test its connection." Foreground="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="24,10" MinHeight="58">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ctrl:Spinner Width="14" Height="14" Stroke="{StaticResource Teal}" Margin="0,0,8,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource PillButton}" Command="{Binding AddCommand}" Content="ADD" Padding="18,9" Margin="0,0,8,0" />
                    <Button Style="{StaticResource PillButton}" Command="{Binding EditCommand}" Content="EDIT" Padding="18,9" Margin="0,0,8,0" />
                    <Button Style="{StaticResource PillButton}" Command="{Binding DeleteCommand}" Content="DELETE" Padding="18,9" Margin="0,0,8,0" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding TestCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:Spinner Width="13" Height="13" Margin="0,0,7,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                            <TextBlock Text="Test Connection" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

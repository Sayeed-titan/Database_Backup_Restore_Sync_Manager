<Window x:Class="PgBackupManager.UI.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        FontFamily="{StaticResource FontUI}" TextOptions.TextFormattingMode="Ideal">

    <Border Background="White" CornerRadius="14" Padding="16,14" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.24" Color="#FF0F2340" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBadge" Grid.Column="0" Width="30" Height="30" CornerRadius="9" VerticalAlignment="Top" Margin="0,0,10,0">
                    <Path x:Name="IconPath" Width="15" Height="15" Stretch="Uniform" StrokeThickness="2.3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Navy}" TextWrapping="Wrap" />
                    <TextBlock x:Name="MessageText" FontSize="11.5" Foreground="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Click="CloseBtn_Click" Width="24" Height="24" Padding="0" VerticalAlignment="Top">
                    <Path Width="10" Height="10" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="2"
                          StrokeStartLineCap="Round" Data="M6 6 L18 18 M18 6 L6 18" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Height="3" CornerRadius="2" Background="{StaticResource BorderLight}" Margin="0,12,0,0" ClipToBounds="True">
                <Border x:Name="ProgressFill" Height="3" CornerRadius="2" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1" />
                    </Border.RenderTransform>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>

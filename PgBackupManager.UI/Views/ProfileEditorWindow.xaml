<Window x:Class="PgBackupManager.UI.Views.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit profile"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="{StaticResource FontUI}"
        Foreground="{DynamicResource Body}"
        TextOptions.TextFormattingMode="Ideal">

    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" CornerRadius="18" Padding="24" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.28" Color="#FF0F2340" />
        </Border.Effect>
        <StackPanel>
            <!-- header -->
            <Grid x:Name="HeaderBar" MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown" Background="Transparent" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TitleText" Text="Add Connection Profile" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Navy}" />
                    <TextBlock Text="Password is encrypted with Windows DPAPI on save." FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Click="CancelBtn_Click" Width="32" Height="32" Padding="0">
                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource Secondary}" StrokeThickness="2" StrokeStartLineCap="Round" Data="M6 6 L18 18 M18 6 L6 18" />
                </Button>
            </Grid>

            <!-- form (scrolls when the SSH section makes it taller than the screen) -->
            <ScrollViewer x:Name="FormScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,12">
                    <TextBlock Text="PROFILE NAME" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,12">
                    <TextBlock Text="ENGINE" Style="{StaticResource FieldLabel}" />
                    <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}"
                              ItemsSource="{Binding Engines}" SelectedItem="{Binding SelectedEngine}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,12" Visibility="{Binding IsServer, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="HOST" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,12" Visibility="{Binding IsServer, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="PORT" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                    <TextBlock Text="{Binding DatabaseLabel}" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding BrowseSqliteFileCommand}" Content="BROWSE" Margin="8,0,0,0"
                                Visibility="{Binding IsSqlite, Converter={StaticResource BoolToVisible}}" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,6,12" Visibility="{Binding ShowCredentials, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="USER" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="6,0,0,12" Visibility="{Binding ShowCredentials, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="PasswordInput" Style="{StaticResource InputPasswordBox}" />
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,6,12" Visibility="{Binding ShowDefaultSchema, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="DEFAULT SCHEMA (optional)" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding DefaultSchema, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="1" Margin="6,0,0,12" VerticalAlignment="Bottom">
                    <CheckBox Style="{StaticResource DesignCheck}" Content="Use Windows Authentication" IsChecked="{Binding SqlIntegratedSecurity}" Margin="0,0,0,10"
                              Visibility="{Binding IsSqlServer, Converter={StaticResource BoolToVisible}}" />
                    <CheckBox Style="{StaticResource DesignCheck}" Content="Database field is a SID (not a service name)" IsChecked="{Binding OracleUseSid}" Margin="0,0,0,10"
                              Visibility="{Binding IsOracle, Converter={StaticResource BoolToVisible}}" />
                </StackPanel>

                <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,4">
                    <TextBlock Text="EXTRA CONNECTION OPTIONS (optional, key=value;...)" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource InputBox}" FontFamily="{StaticResource FontMono}" Text="{Binding ExtraOptions, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Appended to the generated connection string, e.g. SSL Mode=Require;  or  Encrypt=True" />
                </StackPanel>

                <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,12,0,0" Visibility="{Binding IsServer, Converter={StaticResource BoolToVisible}}">
                    <CheckBox Style="{StaticResource DesignCheck}" IsChecked="{Binding ShowSecurity}">
                        <TextBlock>
                            <Run Text="SSL / SSH tunnel options" />
                            <Run Text="{Binding SecuritySummary, Mode=OneWay}" Foreground="{DynamicResource Teal}" FontSize="11" />
                        </TextBlock>
                    </CheckBox>
                    <Grid Margin="0,10,0,0" Visibility="{Binding ShowSecurity, Converter={StaticResource BoolToVisible}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,6,12">
                            <TextBlock Text="SSL / TLS MODE" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}"
                                      ItemsSource="{Binding SslModes}" SelectedItem="{Binding SslMode}"
                                      ToolTip="Require = encrypted, certificate not checked. VerifyCA / VerifyFull also validate the server certificate. Oracle: Require switches to TCPS." />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource DesignCheck}" Content="Connect through an SSH tunnel" IsChecked="{Binding SshEnabled}"
                                  VerticalAlignment="Bottom" Margin="6,0,0,20" />
                        <StackPanel Grid.Row="1" Margin="0,0,6,12" Visibility="{Binding SshEnabled, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="SSH HOST" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource InputBox}" Text="{Binding SshHost, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,12" Visibility="{Binding SshEnabled, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="SSH PORT" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource InputBox}" Text="{Binding SshPort, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,0,6,12" Visibility="{Binding SshEnabled, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="SSH USER" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource InputBox}" Text="{Binding SshUser, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="6,0,0,12" Visibility="{Binding SshEnabled, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="SSH PASSWORD (or key)" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="SshPasswordInput" Style="{StaticResource InputPasswordBox}" />
                        </StackPanel>
                        <Grid Grid.Row="3" Margin="0,0,6,12" Visibility="{Binding SshEnabled, Converter={StaticResource BoolToVisible}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="PRIVATE KEY FILE (optional)" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource InputBox}" Text="{Binding SshKeyFile, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding BrowseSshKeyCommand}" Content="…" VerticalAlignment="Bottom" Margin="6,0,0,0" Padding="12,8" />
                        </Grid>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="6,0,0,12" Visibility="{Binding SshEnabled, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="KEY PASSPHRASE" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="SshPassphraseInput" Style="{StaticResource InputPasswordBox}" />
                        </StackPanel>
                        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource Muted}"
                                   Visibility="{Binding SshEnabled, Converter={StaticResource BoolToVisible}}"
                                   Text="The database host/port above are as seen from the SSH server. Its host key is pinned on first connect and a changed key is refused. SSH secrets are DPAPI-encrypted." />
                    </Grid>
                </StackPanel>

                <TextBlock Grid.Row="7" Grid.ColumnSpan="2" x:Name="TestResultText" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Secondary}" />
            </Grid>
            </ScrollViewer>

            <!-- actions -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="TestBtn" Style="{StaticResource GhostButton}" Click="TestBtn_Click" Content="Test Connection" Padding="16,9" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Click="CancelBtn_Click" Content="Cancel" Padding="18,9" Margin="0,0,8,0" />
                    <Button Style="{StaticResource PrimaryButton}" Click="SaveBtn_Click" Content="Save Profile" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>

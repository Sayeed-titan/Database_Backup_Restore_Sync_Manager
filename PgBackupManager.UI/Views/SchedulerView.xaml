<UserControl x:Class="PgBackupManager.UI.Views.SchedulerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PgBackupManager.UI.ViewModels"
             xmlns:ctrl="clr-namespace:PgBackupManager.UI.Controls">
    <UserControl.DataContext>
        <vm:SchedulerViewModel />
    </UserControl.DataContext>

    <Grid Background="{DynamicResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18,24,8">
            <StackPanel>
                <TextBlock Text="Scheduler" Style="{StaticResource H1}" Margin="0,0,0,4" />
                <TextBlock Text="Presets are saved jobs (transfer, backup or script). Schedule them here, or run one headless from any script:  PgBackupManager.exe --run-preset &quot;name&quot;"
                           Foreground="{DynamicResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,16" />

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- presets -->
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="PRESETS" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                            <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10">
                                <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Height="170" Background="Transparent" BorderThickness="0" DisplayMemberPath="Label" Padding="4" />
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}" Command="{Binding RunPresetNowCommand}" Content="RUN NOW" Margin="0,0,8,0" />
                                <Button Style="{StaticResource GhostButton}" Command="{Binding DeletePresetCommand}" Content="DELETE" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- new schedule -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="SCHEDULE THE SELECTED PRESET" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="FREQUENCY" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}" ItemsSource="{Binding Frequencies}" SelectedItem="{Binding Frequency}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TIME (24h)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource InputBox}" Text="{Binding Time, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Days}" Visibility="{Binding IsWeekly, Converter={StaticResource BoolToVisible}}" Margin="0,0,0,10">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><CheckBox Style="{StaticResource DesignCheck}" Content="{Binding Code}" IsChecked="{Binding IsChecked}" Margin="0,0,12,4" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsHourly, Converter={StaticResource BoolToVisible}}" Margin="0,0,0,10">
                                <TextBlock Text="Every" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Body}" />
                                <TextBox Style="{StaticResource InputBox}" Width="60" Text="{Binding EveryHours}" />
                                <TextBlock Text="hour(s)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Body}" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsOnce, Converter={StaticResource BoolToVisible}}" Margin="0,0,0,10">
                                <TextBlock Text="DATE (yyyy-MM-dd)" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource InputBox}" Width="160" HorizontalAlignment="Left" Text="{Binding Date}" />
                            </StackPanel>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding CreateScheduleCommand}" Content="Create Schedule" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- schedules -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="SCHEDULED TASKS" Style="{StaticResource CardTitle}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButton}" Command="{Binding TriggerScheduleCommand}" Content="RUN NOW" Padding="10,4" FontSize="10" Margin="0,0,6,0" />
                                <Button Style="{StaticResource GhostButton}" Command="{Binding DeleteScheduleCommand}" Content="REMOVE" Padding="10,4" FontSize="10" Margin="0,0,6,0" />
                                <Button Style="{StaticResource GhostButton}" Command="{Binding ReloadSchedulesCommand}" Content="REFRESH" Padding="10,4" FontSize="10" />
                            </StackPanel>
                        </Grid>
                        <DataGrid Style="{StaticResource DesignGrid}" ItemsSource="{Binding Schedules}" SelectedItem="{Binding SelectedSchedule}" AutoGenerateColumns="False" SelectionUnit="FullRow" MinHeight="90" MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PRESET" Binding="{Binding Preset}" Width="2*" />
                                <DataGridTextColumn Header="WHEN" Binding="{Binding When}" Width="2*" />
                                <DataGridTextColumn Header="NEXT RUN" Binding="{Binding NextRun}" Width="150" />
                                <DataGridTextColumn Header="LAST RUN" Binding="{Binding LastRun}" Width="150" />
                                <DataGridTextColumn Header="LAST RESULT" Binding="{Binding LastResult}" Width="100" />
                                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- new presets -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="NEW BACKUP PRESET" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                            <TextBlock Text="CONNECTION (PostgreSQL / SQL Server / MySQL / SQLite)" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}" ItemsSource="{Binding BackupProfiles}" SelectedItem="{Binding BackupProfile}" DisplayMemberPath="DisplayWithEngine" Margin="0,0,0,8" />
                            <TextBlock Text="PRESET NAME" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource InputBox}" Text="{Binding BackupName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,8" Visibility="{Binding BackupIsPg, Converter={StaticResource BoolToVisible}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="FORMAT" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}" ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SCHEMAS (blank = whole database)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource InputBox}" Text="{Binding SchemasCsv, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="DESTINATION ROOT (blank = Settings default)" Style="{StaticResource FieldLabel}" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource InputBox}" Text="{Binding DestinationRoot, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" />
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding BrowseDestinationCommand}" Content="BROWSE" Margin="8,0,0,0" />
                            </Grid>
                            <CheckBox Style="{StaticResource DesignCheck}" Content="Structure only" IsChecked="{Binding SchemaOnly}" Margin="0,0,0,6" />
                            <CheckBox Style="{StaticResource DesignCheck}" Content="Apply retention cleanup after a successful run" IsChecked="{Binding ApplyRetention}" Margin="0,0,0,10" />
                            <Button Style="{StaticResource GhostButton}" Command="{Binding SaveBackupPresetCommand}" Content="SAVE BACKUP PRESET" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="NEW SCRIPT PRESET" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                            <TextBlock Text="CONNECTION" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}" ItemsSource="{Binding AllProfiles}" SelectedItem="{Binding ScriptProfile}" DisplayMemberPath="DisplayWithEngine" Margin="0,0,0,8" />
                            <TextBlock Text="SCRIPT FILE" Style="{StaticResource FieldLabel}" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource InputBox}" Text="{Binding ScriptPath, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" />
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding BrowseScriptCommand}" Content="BROWSE" Margin="8,0,0,0" />
                            </Grid>
                            <TextBlock Text="PRESET NAME" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource InputBox}" Text="{Binding ScriptName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                            <CheckBox Style="{StaticResource DesignCheck}" Content="Stop at the first error" IsChecked="{Binding ScriptStopOnError}" Margin="0,0,0,10" />
                            <Button Style="{StaticResource GhostButton}" Command="{Binding SaveScriptPresetCommand}" Content="SAVE SCRIPT PRESET" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="RUN OUTPUT" Style="{StaticResource FieldLabel}" />
                <Border Margin="0,6,0,4" CornerRadius="10" BorderBrush="{DynamicResource TermBorder}" BorderThickness="1" ClipToBounds="True">
                    <ListBox ItemsSource="{Binding RunLog}" Background="{DynamicResource TermBg}" Height="200" BorderThickness="0" Padding="12,8" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource TermLine}" Foreground="{Binding Converter={StaticResource LogLineBrush}}" /></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" Padding="24,10" MinHeight="46">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ctrl:Spinner Width="13" Height="13" Stroke="{DynamicResource Teal}" Margin="0,0,8,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                <TextBlock Text="{Binding StatusText}" FontSize="12.5" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

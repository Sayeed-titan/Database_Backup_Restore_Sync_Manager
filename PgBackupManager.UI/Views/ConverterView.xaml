<UserControl x:Class="PgBackupManager.UI.Views.ConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PgBackupManager.UI.ViewModels"
             xmlns:ctrl="clr-namespace:PgBackupManager.UI.Controls">
    <UserControl.DataContext>
        <vm:ConverterViewModel />
    </UserControl.DataContext>

    <Grid Background="{DynamicResource AppBg}" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header / controls -->
        <StackPanel Grid.Row="0" Margin="24,18,24,10">
            <TextBlock Text="Code Converter" Style="{StaticResource H1}" Margin="0,0,0,4" />
            <TextBlock Foreground="{DynamicResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Assisted translation of packages, procedures, functions, triggers, sequences, views and DDL. The mechanical work is done for you; anything that needs a human is flagged as WARNING / TODO(convert)." />
            <WrapPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="FROM" Style="{StaticResource FieldLabel}" />
                    <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}" Width="170" ItemsSource="{Binding Engines}" SelectedItem="{Binding From}" />
                </StackPanel>
                <Button Style="{StaticResource PillButton}" Command="{Binding SwapEnginesCommand}" VerticalAlignment="Bottom" Margin="0,0,10,8" Padding="8,8" ToolTip="Swap direction">
                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource Secondary}" StrokeThickness="2" Data="M7 4 L3 8 L7 12 M3 8 H21 M17 12 L21 16 L17 20 M21 16 H3" />
                </Button>
                <StackPanel Margin="0,0,18,8">
                    <TextBlock Text="TO" Style="{StaticResource FieldLabel}" />
                    <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}" Width="170" ItemsSource="{Binding Engines}" SelectedItem="{Binding To}" />
                </StackPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="SOURCE SCHEMA" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource InputBox}" Width="150" Text="{Binding SourceSchema, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" />
                </StackPanel>
                <StackPanel Margin="0,0,18,8">
                    <TextBlock Text="TARGET SCHEMA" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource InputBox}" Width="150" Text="{Binding TargetSchema, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" />
                </StackPanel>
                <CheckBox Style="{StaticResource DesignCheck}" Content="Oracle package → own schema" IsChecked="{Binding PackageAsSchema}" VerticalAlignment="Bottom" Margin="0,0,18,16"
                          ToolTip="On: pkg.proc() call sites keep working (schema per package). Off: targetSchema.pkg_proc()." />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ConvertCommand}" Content="Convert" VerticalAlignment="Bottom" Margin="0,0,0,8" />
            </WrapPanel>

            <!-- load from database -->
            <Expander Header="Load objects from a database" Margin="0,4,0,0" Foreground="{DynamicResource Body}">
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CONNECTION" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}" ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" DisplayMemberPath="DisplayWithEngine" Margin="0,0,0,8" />
                            <Button Style="{StaticResource GhostButton}" Command="{Binding LoadSchemasCommand}" Content="CONNECT" Margin="0,0,0,8" />
                            <TextBlock Text="SCHEMA" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}" ItemsSource="{Binding Schemas}" SelectedItem="{Binding Schema}" Margin="0,0,0,8" />
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding LoadSourceCommand}" Content="Load Source + Convert" />
                        </StackPanel>
                        <Border Grid.Column="2" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" CornerRadius="8">
                            <ListBox ItemsSource="{Binding Objects}" Height="170" Background="Transparent" BorderThickness="0" Padding="8,4" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel ItemWidth="260" /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <CheckBox Style="{StaticResource DesignCheck}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{Binding Name}" />
                                            <TextBlock Text="{Binding TypeLabel}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Teal}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </Border>
            </Expander>
        </StackPanel>

        <!-- source | output -->
        <Grid Grid.Row="1" Margin="24,0,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
                <TextBlock Text="SOURCE" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <Button Style="{StaticResource PillButton}" Command="{Binding OpenSourceFileCommand}" Content="OPEN FILE…" HorizontalAlignment="Right" Padding="8,3" />
            </Grid>
            <Grid Grid.Row="0" Grid.Column="2" Margin="0,0,0,6">
                <TextBlock Text="RESULT" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource PillButton}" Command="{Binding CopyOutputCommand}" Content="COPY" Padding="8,3" Margin="0,0,4,0" />
                    <Button Style="{StaticResource PillButton}" Command="{Binding SaveOutputCommand}" Content="SAVE…" Padding="8,3" Margin="0,0,4,0" />
                    <Button Style="{StaticResource PillButton}" Command="{Binding OpenInEditorCommand}" Content="OPEN IN SQL EDITOR" Padding="8,3" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Grid.Column="0" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource CardBg}">
                <ctrl:SqlTextEditor Code="{Binding Source, Mode=TwoWay}" />
            </Border>
            <Border Grid.Row="1" Grid.Column="2" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource CardBg}">
                <ctrl:SqlTextEditor Code="{Binding Output, Mode=TwoWay}" />
            </Border>
            <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="12,8" Margin="0,10,0,0"
                    Visibility="{Binding Warnings.Count, Converter={StaticResource ZeroToCollapsed}}">
                <StackPanel>
                    <TextBlock Text="{Binding Warnings.Count, StringFormat='NEEDS REVIEW ({0})'}" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource StatusAmber}" />
                    <ItemsControl ItemsSource="{Binding Warnings}" MaxHeight="120">
                        <ItemsControl.Template>
                            <ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer></ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='•  {0}'}" FontSize="11.5" Foreground="{DynamicResource Body}" TextWrapping="Wrap" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" Padding="24,10" MinHeight="46">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ctrl:Spinner Width="13" Height="13" Stroke="{DynamicResource Teal}" Margin="0,0,8,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                <TextBlock Text="{Binding StatusText}" FontSize="12.5" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

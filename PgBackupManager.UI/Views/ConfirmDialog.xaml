<Window x:Class="PgBackupManager.UI.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" FontFamily="{StaticResource FontUI}"
        TextOptions.TextFormattingMode="Ideal">

    <Border Background="White" CornerRadius="18" Padding="24" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.28" Color="#FF0F2340" />
        </Border.Effect>
        <StackPanel>
            <!-- header: icon badge + title + close -->
            <Grid x:Name="HeaderBar" MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown" Background="Transparent" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBadge" Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                        Background="{StaticResource TealBadgeBg}" VerticalAlignment="Top" Margin="0,0,12,0">
                    <Path x:Name="IconPath" Width="18" Height="18" Stretch="Uniform"
                          Stroke="{StaticResource Teal}" StrokeThickness="2.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M10.29 3.86 L1.82 18 a2 2 0 0 0 1.71 3 h16.94 a2 2 0 0 0 1.71 -3 L13.71 3.86 a2 2 0 0 0 -3.42 0 Z M12 9 v4 M12 17 h0.01" />
                </Border>
                <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource Navy}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Click="CloseBtn_Click" Width="32" Height="32" Padding="0" VerticalAlignment="Top">
                    <Path Width="13" Height="13" Stretch="Uniform" Stroke="{StaticResource Secondary}" StrokeThickness="2"
                          StrokeStartLineCap="Round" Data="M6 6 L18 18 M18 6 L6 18" />
                </Button>
            </Grid>

            <!-- body -->
            <TextBlock x:Name="MessageText" FontSize="12.5" Foreground="{StaticResource Body}"
                       TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,4" />

            <!-- actions -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelBtn" Style="{StaticResource GhostButton}" Click="CancelBtn_Click" Content="CANCEL" Padding="18,9" Margin="0,0,8,0" />
                <Button x:Name="ConfirmBtn" Style="{StaticResource PrimaryButton}" Click="ConfirmBtn_Click" Padding="20,9">
                    <TextBlock x:Name="ConfirmBtnText" Text="YES, PROCEED" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

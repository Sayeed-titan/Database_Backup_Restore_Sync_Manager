<UserControl x:Class="PgBackupManager.UI.Views.SchemaCompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PgBackupManager.UI.ViewModels"
             xmlns:ctrl="clr-namespace:PgBackupManager.UI.Controls">
    <UserControl.DataContext>
        <vm:SchemaCompareViewModel />
    </UserControl.DataContext>

    <Grid Background="{DynamicResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,18,24,10">
            <TextBlock Text="Schema Compare" Style="{StaticResource H1}" Margin="0,0,0,4" />
            <TextBlock Text="Structure diff between any two schemas on any two connections — tables, columns, keys, indexes, foreign keys and code. Generates a script that makes the target match the source; nothing runs until you run it."
                       Foreground="{DynamicResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="SOURCE" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SourceProfile}" DisplayMemberPath="DisplayWithEngine" />
                        </StackPanel>
                        <StackPanel x:Name="SourceDbBox" Grid.Row="1" Grid.ColumnSpan="5" Margin="0,8,0,0" Visibility="{Binding HasSourceDatabases, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="DATABASE" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}" ItemsSource="{Binding SourceDatabases}" SelectedItem="{Binding SourceDatabase}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SCHEMA" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}" ItemsSource="{Binding SourceSchemas}" SelectedItem="{Binding SourceSchema}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Button Grid.Column="1" Style="{StaticResource PillButton}" Command="{Binding SwapCommand}" Margin="10,0" VerticalAlignment="Center" Padding="8" ToolTip="Swap source and target">
                    <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Secondary}" StrokeThickness="2" Data="M7 4 L3 8 L7 12 M3 8 H21 M17 12 L21 16 L17 20 M21 16 H3" />
                </Button>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="TARGET (the side the script changes)" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}" ItemsSource="{Binding Profiles}" SelectedItem="{Binding TargetProfile}" DisplayMemberPath="DisplayWithEngine" />
                        </StackPanel>
                        <StackPanel x:Name="TargetDbBox" Grid.Row="1" Grid.ColumnSpan="5" Margin="0,8,0,0" Visibility="{Binding HasTargetDatabases, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="DATABASE" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}" ItemsSource="{Binding TargetDatabases}" SelectedItem="{Binding TargetDatabase}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SCHEMA" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}" ItemsSource="{Binding TargetSchemas}" SelectedItem="{Binding TargetSchema}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <WrapPanel Margin="0,12,0,0">
                <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}" Width="280" ItemsSource="{Binding NameCases}" SelectedItem="{Binding NameCase}" Margin="0,0,14,0" ToolTip="How source names are matched to target names" />
                <CheckBox Style="{StaticResource DesignCheck}" Content="Include views / routines / sequences" IsChecked="{Binding CompareCode}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <CheckBox Style="{StaticResource DesignCheck}" Content="Compare definitions (same engine)" IsChecked="{Binding CompareDefinitions}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding CompareCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <ctrl:Spinner Width="13" Height="13" Margin="0,0,8,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                        <TextBlock Text="Compare" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" Content="CANCEL" IsEnabled="{Binding IsBusy}" />
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="24,0,24,10" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisible}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="8" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <UniformGrid Columns="4" Margin="0,0,0,10">
                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,6,0">
                    <StackPanel><TextBlock Text="TABLES IN BOTH" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding TablesInBoth}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Navy}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="12,8" Margin="3,0">
                    <StackPanel><TextBlock Text="ONLY IN SOURCE" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding OnlySourceCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource StatusGreen}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="12,8" Margin="3,0">
                    <StackPanel><TextBlock Text="ONLY IN TARGET" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding OnlyTargetCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource StatusRed}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="12,8" Margin="6,0,0,0">
                    <StackPanel><TextBlock Text="DIFFERENT" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding DifferentCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource StatusAmber}" /></StackPanel>
                </Border>
            </UniformGrid>
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Style="{StaticResource DesignCheck}" Content="Only in source" IsChecked="{Binding ShowSource}" Margin="0,0,12,0" />
                    <CheckBox Style="{StaticResource DesignCheck}" Content="Only in target" IsChecked="{Binding ShowTarget}" Margin="0,0,12,0" />
                    <CheckBox Style="{StaticResource DesignCheck}" Content="Different" IsChecked="{Binding ShowDifferent}" Margin="0,0,14,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" CornerRadius="8" Padding="11,6">
                    <Grid>
                        <TextBox Style="{StaticResource BareInput}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                        <TextBlock Text="Filter by name / kind / detail…" Foreground="{DynamicResource Muted}" FontSize="12" IsHitTestVisible="False" Visibility="{Binding Search, Converter={StaticResource EmptyToVisible}}" />
                    </Grid>
                </Border>
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="Generate_Click" Margin="10,0,0,0" Padding="14,7"
                        ToolTip="Script for the selected rows (or all rows shown) — opens in the SQL Editor on the target connection" Content="Generate Sync Script" />
            </Grid>
            <DataGrid x:Name="DiffGrid" Grid.Row="2" Style="{StaticResource DesignGrid}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False"
                      SelectionUnit="FullRow" SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="{DynamicResource StatusAmber}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSource}" Value="True"><Setter Property="Foreground" Value="{DynamicResource StatusGreen}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsTarget}" Value="True"><Setter Property="Foreground" Value="{DynamicResource StatusRed}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="KIND" Binding="{Binding Kind}" Width="110" />
                    <DataGridTextColumn Header="OBJECT" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="DETAIL" Binding="{Binding Detail}" Width="3*" />
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeNS" />
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="SOURCE DEFINITION" Style="{StaticResource FieldLabel}" />
                <TextBlock Grid.Column="2" Text="TARGET DEFINITION" Style="{StaticResource FieldLabel}" />
                <Border Grid.Row="1" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource CardBg}">
                    <ctrl:SqlTextEditor Code="{Binding SourceDef, Mode=OneWay}" IsReadOnly="True" />
                </Border>
                <Border Grid.Row="1" Grid.Column="2" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource CardBg}">
                    <ctrl:SqlTextEditor Code="{Binding TargetDef, Mode=OneWay}" IsReadOnly="True" />
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" Padding="24,10" MinHeight="46">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ctrl:Spinner Width="13" Height="13" Stroke="{DynamicResource Teal}" Margin="0,0,8,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                <TextBlock Text="{Binding StatusText}" FontSize="12.5" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

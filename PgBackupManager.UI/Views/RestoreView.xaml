<UserControl x:Class="PgBackupManager.UI.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PgBackupManager.UI.ViewModels"
             xmlns:ctrl="clr-namespace:PgBackupManager.UI.Controls">
    <UserControl.DataContext>
        <vm:RestoreViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <!-- KPI toggle-card -->
        <Style x:Key="KpiCard" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderSoft}" BorderThickness="1.5" Padding="16,13">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource CardSubtle}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,18,24,8">
            <StackPanel>

                <!-- File + profile + analyze -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="BACKUP FILE" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource InputBox}" FontFamily="{StaticResource FontMono}" FontSize="12"
                                 Text="{Binding BackupFile, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding BrowseFileCommand}" VerticalAlignment="Bottom" Height="38" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="13" Height="13" Stretch="Uniform" Stroke="{StaticResource Secondary}" StrokeThickness="2" StrokeLineJoin="Round" Margin="0,0,6,0"
                                  Data="M4 20 h16 a2 2 0 0 0 2 -2 V8 a2 2 0 0 0 -2 -2 h-7.93 a2 2 0 0 1 -1.66 -.9 l-.82 -1.2 A2 2 0 0 0 7.93 3 H4 a2 2 0 0 0 -2 2 v13 a2 2 0 0 0 2 2 Z" />
                            <TextBlock Text="BROWSE" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <CheckBox Grid.Column="2" Style="{StaticResource DesignCheck}" Content="Use latest" IsChecked="{Binding UseLatestBackup}"
                              VerticalAlignment="Bottom" Margin="0,0,14,10"
                              ToolTip="Tick to instantly fill in the most recently written backup file found under the Default Restore Source folder (Settings tab)." />
                    <StackPanel Grid.Column="3" Margin="0,0,10,0" VerticalAlignment="Bottom">
                        <TextBlock Text="TARGET PROFILE" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="180" Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}"
                                  ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" />
                    </StackPanel>
                    <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Command="{Binding AnalyzeCommand}" VerticalAlignment="Bottom" Height="38">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:Spinner Width="13" Height="13" Margin="0,0,7,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                            <TextBlock Text="Analyze" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- RESTORE TARGET banner -->
                <Border Style="{StaticResource Card}" CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="RESTORE INTO" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RestoreTargetText}" FontFamily="{StaticResource FontMono}" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{Binding RestoreTargetBrush}" />
                            <TextBlock Text="{Binding RestoreTargetHint}" FontSize="11" Foreground="{Binding RestoreTargetBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{Binding CreateTargetDbCommand}" Content="CREATE TARGET DB" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Restore options -->
                <WrapPanel Margin="0,0,0,12">
                    <CheckBox Style="{StaticResource DesignCheck}" Content="Single transaction (rollback on error)" IsChecked="{Binding SingleTransaction}" Margin="0,0,18,0" />
                    <CheckBox Style="{StaticResource DesignCheck}" Content="Drop existing first (--clean --if-exists)" IsChecked="{Binding CleanFirst}" Margin="0,0,18,0" />
                    <CheckBox Style="{StaticResource DesignCheck}" Content="--no-owner" IsChecked="{Binding NoOwner}" Margin="0,0,18,0" />
                    <CheckBox Style="{StaticResource DesignCheck}" Content="--no-privileges" IsChecked="{Binding NoPrivileges}" />
                </WrapPanel>

                <!-- Schema include bar -->
                <Border Style="{StaticResource Card}" CornerRadius="12" Padding="12,9" Margin="0,0,0,8"
                        Visibility="{Binding BackupSchemas.Count, Converter={StaticResource ZeroToCollapsed}}">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="Schemas to restore:" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Navy}" VerticalAlignment="Top" Margin="0,4,12,0" />
                        <ItemsControl ItemsSource="{Binding BackupSchemas}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource DesignCheck}" Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,3,18,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- FULL restore guarantee note -->
                <Border Background="{StaticResource TealBadgeBg}" CornerRadius="8" Padding="11,7" Margin="0,0,0,12"
                        Visibility="{Binding BackupSchemas.Count, Converter={StaticResource ZeroToCollapsed}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"
                              Fill="{StaticResource Teal}" Data="M12 2 L4 5 v6 c0 5 3.5 8 8 9 c4.5 -1 8 -4 8 -9 V5 Z M10.5 13.5 L8 11 l-1.3 1.3 L10.5 16 L17 9.5 L15.7 8.2 Z" />
                        <TextBlock VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource Secondary}" TextWrapping="Wrap">
                            <Run Text="FULL restore — every ticked schema is replayed completely:" FontWeight="Bold" />
                            <Run Text="all tables, rows of data, indexes, constraints, sequences and functions. The table below is a read-only preview of what's new vs. already in the target." />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- KPI cards -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="0" Style="{StaticResource KpiCard}" Tag="{StaticResource StatusGreen}" IsChecked="{Binding ShowNew}" Margin="0,0,6,0"
                                  ToolTip="In the backup file but NOT in the target DB — these will be created.">
                        <StackPanel>
                            <TextBlock Text="NEW" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />
                            <TextBlock Text="{Binding NewCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource StatusGreen}" />
                            <TextBlock Text="{Binding NewBreakdown}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Grid.Column="1" Style="{StaticResource KpiCard}" Tag="{StaticResource StatusAmber}" IsChecked="{Binding ShowExisting}" Margin="3,0"
                                  ToolTip="In the backup AND already in the target DB — restore would overwrite them.">
                        <StackPanel>
                            <TextBlock Text="EXISTING" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />
                            <TextBlock Text="{Binding ExistingCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource StatusAmber}" />
                            <TextBlock Text="{Binding ExistingBreakdown}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Grid.Column="2" Style="{StaticResource KpiCard}" Tag="{StaticResource StatusRed}" IsChecked="{Binding ShowMissing}" Margin="3,0"
                                  ToolTip="In the TICKED schemas of the target DB but NOT in this backup — cannot be restored from here (informational). Objects in schemas you haven't ticked are not counted.">
                        <StackPanel>
                            <TextBlock Text="MISSING FROM BACKUP" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />
                            <TextBlock Text="{Binding MissingCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource StatusRed}" />
                            <TextBlock Text="{Binding MissingBreakdown}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </ToggleButton>
                    <Border Grid.Column="3" Style="{StaticResource Card}" CornerRadius="12" Padding="16,13" Margin="3,0"
                            ToolTip="A full restore replays every object in the ticked schemas — plus all their data, indexes, constraints and sequence values. This is the SIZE of the operation, not a guarantee it will succeed — see CHANGES TO TARGET for the real outcome.">
                        <StackPanel>
                            <TextBlock Text="WILL RESTORE" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />
                            <TextBlock Text="{Binding WillRestoreCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Teal}" />
                            <TextBlock Text="+ all data &amp; indexes" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource Card}" CornerRadius="12" Padding="16,13" Margin="6,0,0,0"
                            ToolTip="What will ACTUALLY happen to the target given the current 'Drop existing first' / 'Single transaction' options — the real outcome, not just the operation's size.">
                        <StackPanel>
                            <TextBlock Text="CHANGES TO TARGET" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />
                            <TextBlock Text="{Binding ChangesCount}" FontSize="26" FontWeight="Bold" Foreground="{Binding ChangesBrush}" />
                            <TextBlock Text="{Binding ChangesDetail}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Filter + select buttons -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="8" Padding="11,7" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Stroke="{StaticResource Muted}" StrokeThickness="2" Margin="0,0,8,0"
                                  Data="M11 4 a7 7 0 1 0 0 14 a7 7 0 0 0 0 -14 M21 21 L16.65 16.65" />
                            <Grid Grid.Column="1">
                                <TextBox Style="{StaticResource BareInput}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Filter by kind / schema.name…" Foreground="{StaticResource Muted}" FontSize="12" IsHitTestVisible="False" VerticalAlignment="Center"
                                           Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisible}}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource TealBadgeBg}" CornerRadius="20" Padding="11,5">
                            <TextBlock Text="PREVIEW — restore selection is by schema" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Teal}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Diff table -->
                <Border Style="{StaticResource Card}" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource CardSubtle}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                            <Grid Margin="14,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="STATUS" Style="{StaticResource FieldLabel}" Margin="0" />
                                <TextBlock Grid.Column="2" Text="KIND" Style="{StaticResource FieldLabel}" Margin="0" />
                                <TextBlock Grid.Column="3" Text="SCHEMA" Style="{StaticResource FieldLabel}" Margin="0" />
                                <TextBlock Grid.Column="4" Text="NAME" Style="{StaticResource FieldLabel}" Margin="0" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" MaxHeight="240" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DiffRow}">
                                        <Border Background="Transparent" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="14,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="9" Height="9" CornerRadius="2.5" VerticalAlignment="Center" HorizontalAlignment="Left"
                                        Background="{Binding StatusColor}" ToolTip="Preview only — restore is driven by the schema checkboxes above." />
                                                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11.5" FontWeight="Bold" Foreground="{Binding StatusColor}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Kind}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Schema}" FontSize="12" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding Name}" FontSize="12" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource Navy}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Terminal -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="OUTPUT" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding CopyLogCommand}"
                            Padding="10,3" FontSize="10">
                        <TextBlock Text="COPY LOG" />
                    </Button>
                </Grid>
                <Border Margin="0,6,0,4" CornerRadius="10" BorderBrush="{StaticResource TermBorder}" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="5" />
                            <RowDefinition Height="120" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Background="{StaticResource TermBar}" ClipToBounds="True">
                            <Border HorizontalAlignment="Left" Width="300">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{StaticResource TealColor}" Offset="0" />
                                        <GradientStop Color="{StaticResource Teal2Color}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard Name="slideR">
                                                        <Storyboard>
                                                            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="-300,0,0,0" To="1040,0,0,0" Duration="0:0:1.1" RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <RemoveStoryboard BeginStoryboardName="slideR" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                        <ScrollViewer x:Name="LogScroll" Grid.Row="1" Background="{StaticResource TermBg}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="14,10">
                            <ItemsControl ItemsSource="{Binding LogLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource TermLine}" Foreground="{Binding Converter={StaticResource LogLineBrush}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="24,10" MinHeight="58">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}" Content="CANCEL" Margin="0,0,10,0" Padding="20,9" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartRestoreCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:Spinner Width="13" Height="13" Margin="0,0,8,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                            <TextBlock Text="Start Restore" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="PgBackupManager.UI.Views.CopySchemaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PgBackupManager.UI.ViewModels"
             xmlns:ctrl="clr-namespace:PgBackupManager.UI.Controls">
    <UserControl.DataContext>
        <vm:CopySchemaViewModel />
    </UserControl.DataContext>

    <Grid Background="{StaticResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,18,24,8">
            <StackPanel>
                <TextBlock Text="Copy Schema" Style="{StaticResource H1}" Margin="0,0,0,4" />
                <TextBlock Text="Clone a schema — every table, view, function, sequence and type, plus all its data — into a new schema in the same database."
                           Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,0,0,16" TextWrapping="Wrap" />

                <!-- Profile + load -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="PROFILE" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}"
                                  ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding LoadSchemasCommand}" VerticalAlignment="Bottom" Height="38">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:Spinner Width="13" Height="13" Margin="0,0,7,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                            <TextBlock Text="Load Schemas" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Source -> New name -->
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="SOURCE SCHEMA" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}"
                                      ItemsSource="{Binding AvailableSchemas}" SelectedItem="{Binding SourceSchema}" />
                        </StackPanel>
                        <Path Grid.Column="1" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Bottom" Margin="10,0,10,10"
                              Stroke="{StaticResource Muted}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M5 12 h14 M13 6 l6 6 -6 6" />
                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                            <TextBlock Text="NEW SCHEMA NAME" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource InputBox}" FontFamily="{StaticResource FontMono}"
                                     Text="{Binding NewSchemaName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- note -->
                <Border Background="{StaticResource TealBadgeBg}" CornerRadius="8" Padding="11,7" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{StaticResource Teal}"
                              Data="M12 2 L4 5 v6 c0 5 3.5 8 8 9 c4.5 -1 8 -4 8 -9 V5 Z M10.5 13.5 L8 11 l-1.3 1.3 L10.5 16 L17 9.5 L15.7 8.2 Z" />
                        <TextBlock VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource Secondary}" TextWrapping="Wrap">
                            <Run Text="Read-only on the source:" FontWeight="Bold" />
                            <Run Text="the source schema is never modified — this only dumps it and replays a renamed copy into the new schema. If anything fails, the whole copy is rolled back — nothing is left half-created." />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Terminal -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="OUTPUT" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding CopyLogCommand}" Padding="10,3" FontSize="10">
                        <TextBlock Text="COPY LOG" />
                    </Button>
                </Grid>
                <Border Margin="0,6,0,4" CornerRadius="10" BorderBrush="{StaticResource TermBorder}" BorderThickness="1" ClipToBounds="True">
                    <ScrollViewer Background="{StaticResource TermBg}" Height="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="14,10">
                        <ItemsControl ItemsSource="{Binding LogLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource TermLine}" Foreground="{Binding Converter={StaticResource LogLineBrush}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="24,10" MinHeight="58">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{Binding StatusText, Converter={StaticResource StatusBrush}}" />
                    <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="13"
                               Foreground="{Binding StatusText, Converter={StaticResource StatusBrush}}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0" MinWidth="90"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}">
                    <TextBlock FontSize="11" Foreground="{StaticResource Secondary}" HorizontalAlignment="Right">
                        <Run Text="{Binding ElapsedText, Mode=OneWay}" FontWeight="Bold" />
                        <Run Text=" elapsed" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}"
                            Content="CANCEL" Margin="0,0,10,0" Padding="20,9" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding CopySchemaCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:Spinner Width="13" Height="13" Margin="0,0,8,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                            <TextBlock Text="Copy Schema" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

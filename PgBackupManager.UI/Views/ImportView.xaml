<UserControl x:Class="PgBackupManager.UI.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PgBackupManager.UI.ViewModels"
             xmlns:ctrl="clr-namespace:PgBackupManager.UI.Controls">
    <UserControl.DataContext>
        <vm:ImportViewModel />
    </UserControl.DataContext>

    <Grid Background="{StaticResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,18,24,8">
            <StackPanel>
                <TextBlock Text="Import from SQL Server" Style="{StaticResource H1}" Margin="0,0,0,4" />
                <TextBlock Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,0,0,16" TextWrapping="Wrap"
                           Text="One-way migration into a Postgres schema. SQL Server's .bak format is proprietary — restore it to a live SQL Server first (any recent edition), then point this at that instance. Missing tables are created with type-mapped columns; existing ones only get rows appended." />

                <!-- Source / Target -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="SOURCE (SQL Server, read-only)" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                            <TextBlock Text="SERVER \ INSTANCE" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource InputBox}" Text="{Binding MssqlServer, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <TextBlock Text="DATABASE" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource InputBox}" Text="{Binding MssqlDatabase, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <CheckBox Style="{StaticResource DesignCheck}" Content="Windows Authentication (integrated security)"
                                      IsChecked="{Binding MssqlIntegratedSecurity}" Margin="0,0,0,10" />
                            <Grid Visibility="{Binding UseSqlLogin, Converter={StaticResource BoolToVisible}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SQL LOGIN" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource InputBox}" Text="{Binding MssqlUsername, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}" />
                                    <PasswordBox Style="{StaticResource InputPasswordBox}" x:Name="MssqlPasswordBox" PasswordChanged="MssqlPasswordBox_PasswordChanged" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="SCHEMA" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                            <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}"
                                      ItemsSource="{Binding SourceSchemas}" SelectedItem="{Binding SourceSchema}" />
                        </StackPanel>
                    </Border>

                    <Path Grid.Column="1" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="14,0"
                          Stroke="{StaticResource Muted}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M5 12 h14 M13 6 l6 6 -6 6" />

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="TARGET (Postgres)" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                            <TextBlock Text="PROFILE" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}"
                                      ItemsSource="{Binding Profiles}" SelectedItem="{Binding TargetProfile}" DisplayMemberPath="Name" Margin="0,0,0,10" />
                            <TextBlock Text="SCHEMA (created if missing)" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource InputBox}" FontFamily="{StaticResource FontMono}"
                                     Text="{Binding TargetSchema, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding LoadTablesCommand}" Padding="16,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:Spinner Width="12" Height="12" Margin="0,0,7,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                            <TextBlock Text="Load Tables" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding CompareCommand}" Padding="16,8"
                            ToolTip="Compare table/column/row counts between source and target right now, without running an import.">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:Spinner Width="12" Height="12" Margin="0,0,7,0" Visibility="{Binding IsComparing, Converter={StaticResource BoolToVisible}}" />
                            <TextBlock Text="Compare Report" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Tables -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding AvailableTables.Count, StringFormat='TABLES ({0})'}" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}" Command="{Binding SelectAllTablesCommand}" Content="ALL" Padding="9,3" FontSize="10" Margin="0,0,6,0" />
                                <Button Style="{StaticResource GhostButton}" Command="{Binding SelectNoneTablesCommand}" Content="NONE" Padding="9,3" FontSize="10" />
                            </StackPanel>
                        </Grid>
                        <Border Background="White" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="8" Padding="11,7" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Stroke="{StaticResource Muted}" StrokeThickness="2" Margin="0,0,8,0"
                                      Data="M11 4 a7 7 0 1 0 0 14 a7 7 0 0 0 0 -14 M21 21 L16.65 16.65" />
                                <Grid Grid.Column="1">
                                    <TextBox Style="{StaticResource BareInput}" Text="{Binding TableSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Search tables…" Foreground="{StaticResource Muted}" FontSize="12" IsHitTestVisible="False" VerticalAlignment="Center"
                                               Visibility="{Binding TableSearchText, Converter={StaticResource EmptyToVisible}}" />
                                </Grid>
                            </Grid>
                        </Border>
                        <Border BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="8">
                            <ScrollViewer Height="260" VerticalScrollBarVisibility="Auto" Padding="10,6">
                                <ItemsControl ItemsSource="{Binding FilteredTables}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource DesignCheck}" Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,3,24,3" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Dry run + note -->
                <Border Background="{StaticResource TealBadgeBg}" CornerRadius="8" Padding="11,7" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Style="{StaticResource DesignCheck}" Content="Dry run (preview only — no changes made)" IsChecked="{Binding DryRun}" Margin="0,0,18,0" VerticalAlignment="Center" />
                        <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{StaticResource Teal}"
                              Data="M12 2 L4 5 v6 c0 5 3.5 8 8 9 c4.5 -1 8 -4 8 -9 V5 Z M10.5 13.5 L8 11 l-1.3 1.3 L10.5 16 L17 9.5 L15.7 8.2 Z" />
                        <TextBlock VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource Secondary}" TextWrapping="Wrap">
                            <Run Text="One-way, source is read-only:" FontWeight="Bold" />
                            <Run Text="the SQL Server side is never modified. Column types are best-effort mapped — spot-check anything flagged in the log after a real run." />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Compare report -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16" Visibility="{Binding HasCompareResult, Converter={StaticResource BoolToVisible}}">
                    <StackPanel>
                        <TextBlock Text="COMPARE REPORT — source vs target" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />

                        <!-- Summary cards -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="TABLES  (SRC / TGT)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource Navy}">
                                        <Run Text="{Binding CompareSourceTables, Mode=OneWay}" />
                                        <Run Text=" / " Foreground="{StaticResource Muted}" FontSize="14" />
                                        <Run Text="{Binding CompareTargetTables, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="3,0">
                                <StackPanel>
                                    <TextBlock Text="TOTAL ROWS  (SRC / TGT)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource Navy}">
                                        <Run Text="{Binding CompareSourceRows, Mode=OneWay, StringFormat=N0}" />
                                        <Run Text=" / " Foreground="{StaticResource Muted}" FontSize="14" />
                                        <Run Text="{Binding CompareTargetRows, Mode=OneWay, StringFormat=N0}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="White" BorderBrush="SeaGreen" BorderThickness="1.5" CornerRadius="10" Padding="14,10" Margin="3,0">
                                <StackPanel>
                                    <TextBlock Text="% MATCHED" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="SeaGreen">
                                        <Run Text="{Binding CompareMatchedPercent, Mode=OneWay, StringFormat={}{0}%}" />
                                        <Run Text=" " />
                                        <Run FontSize="11" Foreground="{StaticResource Muted}" Text="{Binding CompareMatchedCount, Mode=OneWay, StringFormat=({0})}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Background="White" BorderBrush="IndianRed" BorderThickness="1.5" CornerRadius="10" Padding="14,10" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="% NOT MATCHED" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="IndianRed">
                                        <Run Text="{Binding CompareMismatchedPercent, Mode=OneWay, StringFormat={}{0}%}" />
                                        <Run Text=" " />
                                        <Run FontSize="11" Foreground="{StaticResource Muted}" Text="{Binding CompareMismatchedCount, Mode=OneWay, StringFormat=({0})}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Filter toggles + search -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                <CheckBox Style="{StaticResource DesignCheck}" Content="Matched" IsChecked="{Binding ShowCompareMatched}" Margin="0,0,14,0" />
                                <CheckBox Style="{StaticResource DesignCheck}" Content="Not matched" IsChecked="{Binding ShowCompareMismatched}" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="8" Padding="11,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Stroke="{StaticResource Muted}" StrokeThickness="2" Margin="0,0,8,0"
                                          Data="M11 4 a7 7 0 1 0 0 14 a7 7 0 0 0 0 -14 M21 21 L16.65 16.65" />
                                    <Grid Grid.Column="1">
                                        <TextBox Style="{StaticResource BareInput}" Text="{Binding CompareSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Filter by table name…" Foreground="{StaticResource Muted}" FontSize="12" IsHitTestVisible="False" VerticalAlignment="Center"
                                                   Visibility="{Binding CompareSearchText, Converter={StaticResource EmptyToVisible}}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Rows -->
                        <Border BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource CardSubtle}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                                    <Grid Margin="12,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="TABLE" Style="{StaticResource FieldLabel}" Margin="0" />
                                        <TextBlock Grid.Column="1" Text="SRC COLS" Style="{StaticResource FieldLabel}" Margin="0" />
                                        <TextBlock Grid.Column="2" Text="TGT COLS" Style="{StaticResource FieldLabel}" Margin="0" />
                                        <TextBlock Grid.Column="3" Text="SRC ROWS" Style="{StaticResource FieldLabel}" Margin="0" />
                                        <TextBlock Grid.Column="4" Text="TGT ROWS" Style="{StaticResource FieldLabel}" Margin="0" />
                                        <TextBlock Grid.Column="5" Text="STATUS" Style="{StaticResource FieldLabel}" Margin="0" />
                                    </Grid>
                                </Border>
                                <ScrollViewer Grid.Row="1" MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding CompareRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:CompareRowVm}">
                                                <Border Background="Transparent" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="12,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="110" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Table}" FontSize="12" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource Navy}" VerticalAlignment="Center" ToolTip="{Binding MismatchReason}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding SourceColumns}" FontSize="12" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding TargetColumns}" FontSize="12" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{Binding SourceRows}" FontSize="12" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="4" Text="{Binding TargetRows}" FontSize="12" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="5" Text="{Binding StatusText}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusColor}" VerticalAlignment="Center" ToolTip="{Binding MismatchReason}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Terminal -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="OUTPUT" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding CopyLogCommand}" Padding="10,3" FontSize="10">
                        <TextBlock Text="COPY LOG" />
                    </Button>
                </Grid>
                <Border Margin="0,6,0,4" CornerRadius="10" BorderBrush="{StaticResource TermBorder}" BorderThickness="1" ClipToBounds="True">
                    <ScrollViewer Background="{StaticResource TermBg}" Height="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="14,10">
                        <ItemsControl ItemsSource="{Binding LogLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource TermLine}" Foreground="{Binding Converter={StaticResource LogLineBrush}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="24,10" MinHeight="58">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{Binding StatusText, Converter={StaticResource StatusBrush}}" />
                    <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="13"
                               Foreground="{Binding StatusText, Converter={StaticResource StatusBrush}}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0" MinWidth="90"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}">
                    <TextBlock FontSize="11" Foreground="{StaticResource Secondary}" HorizontalAlignment="Right">
                        <Run Text="{Binding ElapsedText, Mode=OneWay}" FontWeight="Bold" />
                        <Run Text=" elapsed" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}"
                            Content="CANCEL" Margin="0,0,10,0" Padding="20,9" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding RunCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:Spinner Width="13" Height="13" Margin="0,0,8,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                            <TextBlock Text="{Binding RunButtonText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

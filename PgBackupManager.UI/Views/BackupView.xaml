<UserControl x:Class="PgBackupManager.UI.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PgBackupManager.UI.ViewModels"
             xmlns:ctrl="clr-namespace:PgBackupManager.UI.Controls">
    <UserControl.DataContext>
        <vm:BackupViewModel />
    </UserControl.DataContext>

    <Grid Background="{StaticResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,18,24,8">
            <StackPanel>

                <!-- Profile + Load -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="PROFILE" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}"
                                  ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding LoadObjectsCommand}" VerticalAlignment="Bottom" Height="38">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:Spinner Width="13" Height="13" Margin="0,0,7,0"
                                          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                            <TextBlock Text="Load DB Objects" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Scope / Format / Content / Jobs -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,7,0">
                        <TextBlock Text="SCOPE" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}"
                                  ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="7,0">
                        <TextBlock Text="FORMAT" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}"
                                  ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="7,0">
                        <TextBlock Text="CONTENT" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}"
                                  ItemsSource="{Binding Contents}" SelectedItem="{Binding SelectedContent}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="7,0,0,0"
                                ToolTip="pg_dump --jobs=N — only works with 'Directory (parallel)' format; ignored/blocked otherwise.">
                        <TextBlock Text="JOBS" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource InputBox}" Width="50" TextAlignment="Center" Text="{Binding ParallelJobs, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <!-- Schema tree card -->
                <Border Style="{StaticResource Card}" CornerRadius="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- filter bar -->
                        <Border Grid.Row="0" Background="{StaticResource CardSubtle}" BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="0,0,0,1" CornerRadius="14,14,0,0">
                            <Grid Margin="12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                                      Stroke="{StaticResource Muted}" StrokeThickness="2" Margin="0,0,10,0"
                                      Data="M11 4 a7 7 0 1 0 0 14 a7 7 0 0 0 0 -14 M21 21 L16.65 16.65" />
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="FilterBox" Style="{StaticResource BareInput}"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Filter schemas and tables…" Foreground="{StaticResource Muted}" FontSize="12.5"
                                               IsHitTestVisible="False" VerticalAlignment="Center"
                                               Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisible}}" />
                                </Grid>
                                <Border Grid.Column="2" Background="{StaticResource TealBadgeBg}" CornerRadius="20" Padding="9,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedSummary}" Foreground="{StaticResource Teal}" FontWeight="Bold" FontSize="10" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- tree -->
                        <ScrollViewer Grid.Row="1" MaxHeight="248" VerticalScrollBarVisibility="Auto" Padding="0,4">
                            <ItemsControl ItemsSource="{Binding Schemas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SchemaNode}">
                                        <StackPanel>
                                            <Border Background="Transparent" Padding="14,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- chevron -->
                                                    <ToggleButton Grid.Column="0" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                  Cursor="Hand" Background="Transparent" BorderThickness="0"
                                                                  Visibility="{Binding HasObjects, Converter={StaticResource BoolToVisible}}">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="Transparent">
                                                                    <Path x:Name="chev" Width="11" Height="11" Stretch="Uniform"
                                                                          Stroke="{StaticResource Muted}" StrokeThickness="2.4"
                                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                                          Data="M9 6 L15 12 L9 18" RenderTransformOrigin="0.5,0.5" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="chev" Property="Data" Value="M6 9 L12 15 L18 9" />
                                                                        <Setter TargetName="chev" Property="Stroke" Value="{StaticResource Secondary}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                    <!-- checkbox -->
                                                    <CheckBox Grid.Column="1" Style="{StaticResource DesignCheck}" Margin="2,0,0,0"
                                                              IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13" FontWeight="Bold"
                                                               Foreground="{StaticResource Navy}" VerticalAlignment="Center" Margin="8,0,8,0" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Summary}" FontSize="11"
                                                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <!-- folders: Tables / Views / Functions / Sequences / Types -->
                                            <ItemsControl ItemsSource="{Binding Groups}"
                                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisible}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ObjectGroup}">
                                                        <StackPanel>
                                                            <!-- folder header -->
                                                            <Border Background="Transparent" Padding="36,4,14,4">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="16" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <ToggleButton Grid.Column="0" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                                  Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                                        <ToggleButton.Template>
                                                                            <ControlTemplate TargetType="ToggleButton">
                                                                                <Border Background="Transparent">
                                                                                    <Path x:Name="gchev" Width="10" Height="10" Stretch="Uniform"
                                                                                          Stroke="{StaticResource Muted}" StrokeThickness="2.4"
                                                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                                                          Data="M9 6 L15 12 L9 18" />
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsChecked" Value="True">
                                                                                        <Setter TargetName="gchev" Property="Data" Value="M6 9 L12 15 L18 9" />
                                                                                        <Setter TargetName="gchev" Property="Stroke" Value="{StaticResource Secondary}" />
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </ToggleButton.Template>
                                                                    </ToggleButton>
                                                                    <Path Grid.Column="1" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="3,0,0,0"
                                                                          Fill="{StaticResource Teal}"
                                                                          Data="M3 6 a1 1 0 0 1 1 -1 h4.5 l1.5 1.7 H20 a1 1 0 0 1 1 1 V18 a1 1 0 0 1 -1 1 H4 a1 1 0 0 1 -1 -1 Z" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding Header}" FontSize="11.5" FontWeight="Bold"
                                                                               Foreground="{StaticResource Secondary}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                                </Grid>
                                                            </Border>
                                                            <!-- objects in the folder -->
                                                            <ItemsControl ItemsSource="{Binding Objects}"
                                                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisible}}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:ObjectNode}">
                                                                        <Border Background="Transparent" Padding="68,3,14,3">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="22" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <!-- only tables are individually selectable for pg_dump -->
                                                                                <CheckBox Grid.Column="0" Style="{StaticResource DesignCheck}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                                          VerticalAlignment="Center"
                                                                                          Visibility="{Binding IsTable, Converter={StaticResource BoolToVisible}}" />
                                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="{StaticResource FontMono}" FontSize="12"
                                                                                           Foreground="{StaticResource Body}" VerticalAlignment="Center" />
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Destination -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="DESTINATION ROOT" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding DestinationRoot, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding BrowseDestinationCommand}" VerticalAlignment="Bottom" Height="38" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="13" Height="13" Stretch="Uniform" Stroke="{StaticResource Secondary}" StrokeThickness="2"
                                  StrokeLineJoin="Round" Margin="0,0,6,0"
                                  Data="M4 20 h16 a2 2 0 0 0 2 -2 V8 a2 2 0 0 0 -2 -2 h-7.93 a2 2 0 0 1 -1.66 -.9 l-.82 -1.2 A2 2 0 0 0 7.93 3 H4 a2 2 0 0 0 -2 2 v13 a2 2 0 0 0 2 2 Z" />
                            <TextBlock Text="BROWSE" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <CheckBox Grid.Column="2" Style="{StaticResource DesignCheck}" Content="Auto Y/M/D folders"
                              IsChecked="{Binding UseAutoFolders}" VerticalAlignment="Bottom" Height="38" />
                </Grid>
                <TextBlock Text="{Binding FullPathPreview}" FontFamily="{StaticResource FontMono}" FontSize="11"
                           Foreground="{StaticResource Muted}" Margin="2,7,0,0" TextTrimming="CharacterEllipsis" />

                <!-- Terminal -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="OUTPUT" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding CopyLogCommand}"
                            Padding="10,3" FontSize="10">
                        <TextBlock Text="COPY LOG" />
                    </Button>
                </Grid>
                <Border Margin="0,6,0,4" CornerRadius="10" BorderBrush="{StaticResource TermBorder}" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="5" />
                            <RowDefinition Height="160" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Background="{StaticResource TermBar}" ClipToBounds="True">
                            <Border x:Name="BackupBar" HorizontalAlignment="Left" Width="300">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{StaticResource TealColor}" Offset="0" />
                                        <GradientStop Color="{StaticResource Teal2Color}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard Name="slideSb">
                                                        <Storyboard>
                                                            <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                                From="-300,0,0,0" To="1040,0,0,0" Duration="0:0:1.1" RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <RemoveStoryboard BeginStoryboardName="slideSb" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                        <ScrollViewer x:Name="LogScroll" Grid.Row="1" Background="{StaticResource TermBg}" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto" Padding="14,10">
                            <ItemsControl ItemsSource="{Binding LogLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource TermLine}"
                                                   Foreground="{Binding Converter={StaticResource LogLineBrush}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="24,10" MinHeight="58">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{Binding StatusText, Converter={StaticResource StatusBrush}}" />
                    <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="13"
                               Foreground="{Binding StatusText, Converter={StaticResource StatusBrush}}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0" MinWidth="170"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}">
                    <TextBlock FontSize="11" Foreground="{StaticResource Secondary}" HorizontalAlignment="Right">
                        <Run Text="{Binding ElapsedText, Mode=OneWay}" FontWeight="Bold" />
                        <Run Text=" elapsed" />
                        <Run Text="  ·  " />
                        <Run Text="{Binding EtaText, Mode=OneWay}" />
                    </TextBlock>
                    <ProgressBar Height="5" Margin="0,4,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                                 Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisible}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}"
                            Content="CANCEL" Margin="0,0,10,0" Padding="20,9" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartBackupCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:Spinner Width="13" Height="13" Margin="0,0,8,0"
                                          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                            <TextBlock Text="Start Backup" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

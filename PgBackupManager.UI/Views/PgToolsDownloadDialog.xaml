<Window x:Class="PgBackupManager.UI.Views.PgToolsDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download PostgreSQL Client Tools"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" FontFamily="{StaticResource FontUI}"
        TextOptions.TextFormattingMode="Ideal">

    <Border Background="White" CornerRadius="18" Padding="24" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.28" Color="#FF0F2340" />
        </Border.Effect>
        <StackPanel>
            <!-- header -->
            <Grid x:Name="HeaderBar" MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown" Background="Transparent" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                        Background="{StaticResource TealBadgeBg}" VerticalAlignment="Top" Margin="0,0,12,0">
                    <Path Width="18" Height="18" Stretch="Uniform"
                          Stroke="{StaticResource Teal}" StrokeThickness="2.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M12 3 v12 M7 10 l5 5 5 -5 M5 21 h14" />
                </Border>
                <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource Navy}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button x:Name="CloseXBtn" Grid.Column="2" Style="{StaticResource GhostButton}" Click="CancelBtn_Click"
                        Width="32" Height="32" Padding="0" VerticalAlignment="Top">
                    <Path Width="13" Height="13" Stretch="Uniform" Stroke="{StaticResource Secondary}" StrokeThickness="2"
                          StrokeStartLineCap="Round" Data="M6 6 L18 18 M18 6 L6 18" />
                </Button>
            </Grid>

            <!-- body -->
            <TextBlock x:Name="MessageText" FontSize="12.5" Foreground="{StaticResource Body}"
                       TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,4" />

            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,16,0,0">
                <Grid Margin="0,0,0,6">
                    <TextBlock x:Name="PhaseText" Text="Connecting..." FontSize="11.5" Foreground="{StaticResource Secondary}" />
                    <TextBlock x:Name="SizeText" FontSize="11.5" Foreground="{StaticResource Secondary}" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar x:Name="ProgressBarCtl" Height="8" Minimum="0" Maximum="100" />
            </StackPanel>

            <!-- actions -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelBtn" Style="{StaticResource GhostButton}" Click="CancelBtn_Click" Content="CANCEL" Padding="18,9" Margin="0,0,8,0" />
                <Button x:Name="StartBtn" Style="{StaticResource PrimaryButton}" Click="StartBtn_Click" Padding="20,9">
                    <TextBlock Text="DOWNLOAD" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

<UserControl x:Class="PgBackupManager.UI.Views.DataCompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PgBackupManager.UI.ViewModels"
             xmlns:ctrl="clr-namespace:PgBackupManager.UI.Controls">
    <UserControl.DataContext>
        <vm:DataCompareViewModel />
    </UserControl.DataContext>

    <Grid Background="{DynamicResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,18,24,10">
            <TextBlock Text="Data Compare" Style="{StaticResource H1}" Margin="0,0,0,4" />
            <TextBlock Text="Row-by-row diff of one table across any two connections. Rows are matched on the key and values compared after converting to the target's types — then insert the missing, update the changed and (optionally) delete the extra rows on the target, in one transaction."
                       Foreground="{DynamicResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="SOURCE" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SourceProfile}" DisplayMemberPath="DisplayWithEngine" />
                        </StackPanel>
                        <StackPanel x:Name="SourceDbBox" Grid.Row="1" Grid.ColumnSpan="5" Margin="0,8,0,0" Visibility="{Binding HasSourceDatabases, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="DATABASE" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}" ItemsSource="{Binding SourceDatabases}" SelectedItem="{Binding SourceDatabase}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SCHEMA" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}" ItemsSource="{Binding SourceSchemas}" SelectedItem="{Binding SourceSchema}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="TABLE" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}" ItemsSource="{Binding SourceTables}" SelectedItem="{Binding SourceTable}" IsTextSearchEnabled="True" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Button Grid.Column="1" Style="{StaticResource PillButton}" Command="{Binding SwapCommand}" Margin="10,0" VerticalAlignment="Center" Padding="8" ToolTip="Swap source and target">
                    <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Secondary}" StrokeThickness="2" Data="M7 4 L3 8 L7 12 M3 8 H21 M17 12 L21 16 L17 20 M21 16 H3" />
                </Button>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="TARGET (the side Apply changes)" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}" ItemsSource="{Binding Profiles}" SelectedItem="{Binding TargetProfile}" DisplayMemberPath="DisplayWithEngine" />
                        </StackPanel>
                        <StackPanel x:Name="TargetDbBox" Grid.Row="1" Grid.ColumnSpan="5" Margin="0,8,0,0" Visibility="{Binding HasTargetDatabases, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="DATABASE" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}" ItemsSource="{Binding TargetDatabases}" SelectedItem="{Binding TargetDatabase}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SCHEMA" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}" ItemsSource="{Binding TargetSchemas}" SelectedItem="{Binding TargetSchema}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="TABLE" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource InputCombo}" ItemContainerStyle="{StaticResource InputComboItem}" ItemsSource="{Binding TargetTables}" SelectedItem="{Binding TargetTable}" IsTextSearchEnabled="True" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <WrapPanel Margin="0,12,0,0">
                <CheckBox Style="{StaticResource DesignCheck}" Content="Options (key, filters, ignored columns)" IsChecked="{Binding ShowOptions}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <CheckBox Style="{StaticResource DesignCheck}" Content="Ignore trailing spaces" IsChecked="{Binding IgnoreTrailingSpaces}" VerticalAlignment="Center" Margin="0,0,14,0"
                          ToolTip="CHAR columns are blank-padded differently by each engine" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding CompareCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <ctrl:Spinner Width="13" Height="13" Margin="0,0,8,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                        <TextBlock Text="Compare" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" Content="CANCEL" IsEnabled="{Binding IsBusy}" />
            </WrapPanel>
            <Grid Margin="0,10,0,0" Visibility="{Binding ShowOptions, Converter={StaticResource BoolToVisible}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="KEY COLUMNS (blank = primary key)" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding KeyColumns, UpdateSourceTrigger=PropertyChanged}" ToolTip="Comma-separated, e.g. order_no, line_no" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="IGNORE COLUMNS" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding IgnoreColumns, UpdateSourceTrigger=PropertyChanged}" ToolTip="Not compared (e.g. updated_at), still copied on insert" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="SOURCE ROW FILTER (SQL WHERE)" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource InputBox}" FontFamily="{StaticResource FontMono}" Text="{Binding SourceFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="TARGET ROW FILTER (SQL WHERE)" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource InputBox}" FontFamily="{StaticResource FontMono}" Text="{Binding TargetFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1" Margin="24,0,24,10" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisible}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <UniformGrid Columns="4" Margin="0,0,0,8">
                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,6,0">
                    <StackPanel><TextBlock Text="SAME" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding SameCount, StringFormat=N0}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Navy}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="12,8" Margin="3,0">
                    <StackPanel><TextBlock Text="ONLY IN SOURCE" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding OnlySourceCount, StringFormat=N0}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource StatusGreen}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="12,8" Margin="3,0">
                    <StackPanel><TextBlock Text="ONLY IN TARGET" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding OnlyTargetCount, StringFormat=N0}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource StatusRed}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="12,8" Margin="6,0,0,0">
                    <StackPanel><TextBlock Text="DIFFERENT" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding DifferentCount, StringFormat=N0}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource StatusAmber}" /></StackPanel>
                </Border>
            </UniformGrid>
            <TextBlock Grid.Row="1" Text="{Binding Notes}" FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SHOW" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <CheckBox Style="{StaticResource DesignCheck}" Content="Only in source" IsChecked="{Binding ShowSource}" Margin="0,0,12,0" />
                    <CheckBox Style="{StaticResource DesignCheck}" Content="Only in target" IsChecked="{Binding ShowTarget}" Margin="0,0,12,0" />
                    <CheckBox Style="{StaticResource DesignCheck}" Content="Different" IsChecked="{Binding ShowDifferent}" Margin="0,0,14,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" CornerRadius="8" Padding="11,6" MinWidth="120">
                    <Grid>
                        <TextBox Style="{StaticResource BareInput}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                        <TextBlock Text="Filter by key / column…" Foreground="{DynamicResource Muted}" FontSize="12" IsHitTestVisible="False" Visibility="{Binding Search, Converter={StaticResource EmptyToVisible}}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="APPLY" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <CheckBox Style="{StaticResource DesignCheck}" Content="Insert" IsChecked="{Binding ApplyInsert}" Margin="0,0,10,0" />
                    <CheckBox Style="{StaticResource DesignCheck}" Content="Update" IsChecked="{Binding ApplyUpdate}" Margin="0,0,10,0" />
                    <CheckBox Style="{StaticResource DesignCheck}" Content="Delete extra" IsChecked="{Binding ApplyDelete}" ToolTip="Delete target rows that aren't in the source" />
                </StackPanel>
                <Button Grid.Column="3" Style="{StaticResource GhostButton}" Click="Script_Click" Margin="10,0,0,0" Padding="12,7" HorizontalAlignment="Left"
                        ToolTip="Same changes as a SQL script in the target's dialect — opens in the SQL Editor for review" Content="Generate Script" />
                <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Click="Apply_Click" Margin="8,0,0,0" Padding="14,7" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        ToolTip="Selected rows (2+), or every row the filters show — asks before writing" Content="Apply to Target…" />
            </Grid>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <DataGrid x:Name="DiffGrid" Style="{StaticResource DesignGrid}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False"
                          SelectionUnit="FullRow" SelectionMode="Extended" IsReadOnly="True" EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Foreground" Value="{DynamicResource StatusAmber}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSource}" Value="True"><Setter Property="Foreground" Value="{DynamicResource StatusGreen}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsTarget}" Value="True"><Setter Property="Foreground" Value="{DynamicResource StatusRed}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="KEY" Binding="{Binding Key}" Width="*" />
                        <DataGridTextColumn Header="CHANGED COLUMNS" Binding="{Binding ChangedText}" Width="1.6*" />
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid Grid.Column="2" Style="{StaticResource DesignGrid}" ItemsSource="{Binding Cells}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="COLUMN" Binding="{Binding Column}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Changed}" Value="True"><Setter Property="FontWeight" Value="Bold" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="1.5*" />
                        <DataGridTextColumn Header="TARGET" Binding="{Binding Target}" Width="1.5*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Changed}" Value="True"><Setter Property="Foreground" Value="{DynamicResource StatusAmber}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" Padding="24,10" MinHeight="46">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ctrl:Spinner Width="13" Height="13" Stroke="{DynamicResource Teal}" Margin="0,0,8,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                <TextBlock Text="{Binding StatusText}" FontSize="12.5" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
